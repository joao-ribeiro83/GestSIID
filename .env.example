# GestSIID Node.js — environment template. Copy to .env and fill in. Never commit .env.

# Oracle connection (node-oracledb "thin" mode: no Oracle client install needed in the container;
# requires Oracle Database 12.1+ — Step 0.2 of analysis/MASTER_PLAN.md confirms the version)
DB_USER=
DB_PASSWORD=
# host:port/service_name  (the Forms app used TNS aliases cosec / cosec01; ask the DBA for the service names)
DB_CONNECT_STRING=host:1521/SERVICE
# Schema that owns the SIID objects (the schema that owns table MRECIBO). The Forms app created private
# synonyms pointing at "<schema>.<object>"; the Node app sets CURRENT_SCHEMA instead.
DB_SCHEMA=
# Environment label used as CFG_UTILIZADORES.AMBIENTE_ID / SVR_VARIAVEIS_SIID.AMBIENTE_ID (e.g. DEV, GADOR_TESTES, COSEC)
AMBIENTE_ID=
DB_POOL_MIN=2
DB_POOL_MAX=10

# HTTP
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
# Long random string; used to sign session cookies
SESSION_SECRET=
# Session lifetime in minutes
SESSION_TTL_MINUTES=480

# Document viewer: the Forms app opened PDFs from the SIID file server REST API
# (…/FileServerSIID/restapi/FileServer/pdf/T?spoolid=<id> for test, /pdf/P for production).
# The API proxies these requests after checking the session; the browser never calls the file server directly.
FILESERVER_URL=http://host:8090/FileServerSIID/restapi/FileServer
# T or P — path segment used by the file server for this environment
FILESERVER_ENV=T
# Optional bearer/basic credential if the file server requires one (leave empty if not)
FILESERVER_TOKEN=

# Uploads (section signature images stored in DOC_SECCOES_DOCUMENTO.IMAGEM)
UPLOAD_MAX_MB=10
