# GestSIID Node.js — environment template (analysis/ARCHITECTURE.md §2). Copy to .env and fill in. Never commit .env.
# One file per environment (one container per environment, DECISIONS D-02). tools/db-discovery reads the DB_* keys too.

# --- Runtime
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# '' (served at /) or a sub-path such as /gestsiid (D-09)
BASE_PATH=

# --- Oracle (node-oracledb Thick mode, D-31: the account has a legacy password verifier, Thin mode fails with NJS-116)
DB_USER=
DB_PASSWORD=
# host:port/service_name
DB_CONNECT_STRING=host:1521/SERVICE
# Schema that owns the SIID objects; set as CURRENT_SCHEMA on every pooled connection. Test value below — change for production (D-27).
DB_SCHEMA=SIID_TESTES
# Must equal GET_AMBIENTE_ID() in that schema, or the API refuses to start (D-27). Test value — change for production.
AMBIENTE_ID=GADOR_TESTES
# Fixed-size pool (poolMin = poolMax, Oracle guidance)
DB_POOL_SIZE=4
# Per database call timeout
DB_CALL_TIMEOUT_MS=60000
# Thick mode worker threads; must be >= DB_POOL_SIZE (the Docker image sets 8)
UV_THREADPOOL_SIZE=8
# Oracle client libraries. Empty in the container (Instant Client is registered with ldconfig).
# Windows dev: the Forms middleware client, e.g. I:\Middleware\Oracle_Home\bin
ORACLE_CLIENT_LIB_DIR=

# --- Session and cookies (D-07c, D-09). Lifetime (8 h absolute, 30 min idle) is fixed in code.
# Long random string, at least 32 characters
SESSION_SECRET=
# false on plain HTTP; true once nginx terminates TLS in front of the app. While false, the session
# cookie travels in clear text and the API logs a warning at boot: fix before go-live.
COOKIE_SECURE=false
# false, or the reverse proxy's IP / CIDR list when nginx is in front (e.g. 172.18.0.0/16).
# 'true' is refused: it would trust any X-Forwarded-For a client sends.
# Behind a proxy this MUST be set: the login limits (5 attempts/min per IP) count the proxy's IP,
# so with 'false' every user shares one counter and a few wrong passwords block everyone.
TRUST_PROXY=false

# --- Document viewer (D-03): full FileServerSIID PDF URL for this environment; the API adds ?spoolid=<id>
# Production: http://ssiid-prod.cosec.pt:8090/FileServerSIID/restapi/FileServer/pdf/P
FILESERVER_BASE_URL=http://ssiidt.cosec.pt:8090/FileServerSIID/restapi/FileServer/pdf/T
FILESERVER_TIMEOUT_MS=15000

# --- Uploads (section images DOC_SECCOES_DOCUMENTO.IMAGEM, signatures DOC_PERFIS_DEPARTAMENTO.ASSINATURA)
UPLOAD_MAX_MB=10
